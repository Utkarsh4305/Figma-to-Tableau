# Razorpay API keys — Dashboard > Account & Settings > API Keys.
# Use test-mode keys (rzp_test_...) until the flow is verified end to end.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — the subscription plan (Dashboard > Subscriptions > Plans > Create
# Plan; monthly, $10 USD w/ international payments enabled, or the INR
# equivalent). WITH a plan id the checkout bills a monthly SUBSCRIPTION;
# WITHOUT one it falls back to Standard Checkout one-time ORDERS, where each
# payment grants PREMIUM_DAYS of Premium.
#RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx

# One-time order mode settings (ignored in subscription mode). Amount is in
# the currency's smallest unit (paise for INR): 85000 = ₹850. Minimum 100.
ORDER_AMOUNT_PAISE=85000
ORDER_CURRENCY=INR
PREMIUM_DAYS=31

# Webhook signing secret — Dashboard > Account & Settings > Webhooks.
# Point the webhook at https://<this-server>/api/webhook with events:
# subscription.activated, subscription.charged, subscription.cancelled,
# subscription.halted, subscription.completed.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Optional
PORT=3000
PRICE_LABEL=$10/month
