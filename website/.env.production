# Production config for the marketing site — loaded by `vite build` and takes
# precedence over .env (which stays localhost for local dev). VITE_ vars are
# PUBLIC (inlined into the client bundle) — never put a secret here.

# The deployed billing backend (Render). Without this, production would bake in
# .env's localhost:3000 and checkout links would point at the developer's machine.
VITE_BACKEND_URL=https://figma-tableau-backend.onrender.com

# Razorpay publishable key id (safe to expose — the secret stays on the backend).
VITE_RAZORPAY_KEY_ID=rzp_live_TBjDYOWOGNX8bn
