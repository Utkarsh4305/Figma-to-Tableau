{
  "name": "figma-to-tableau",
  "version": "1.0.0",
  "description": "Figma plugin that converts dashboard designs into downloadable Tableau .twbx workbooks (Tableau 2026.2).",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:ui": "node scripts/build-ui.mjs",
    "build:code": "esbuild src/plugin/code.ts --bundle --target=es2017 --format=iife --outfile=dist/code.js",
    "build": "npm run build:ui && npm run build:code",
    "watch:ui": "vite build --watch",
    "watch:code": "esbuild src/plugin/code.ts --bundle --target=es2017 --format=iife --outfile=dist/code.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.ts && tsx test/spec_smoke.ts && tsx test/lds_smoke.ts"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
