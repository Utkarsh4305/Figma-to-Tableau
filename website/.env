# Local dev config for the marketing site.
# VITE_ vars are PUBLIC — they are inlined into the client bundle. Never put a
# secret here (the Razorpay *secret* stays in backend/.env only).

# The billing backend (repo /backend).
VITE_BACKEND_URL=http://localhost:3000

# Razorpay publishable key id (same value as backend/.env RAZORPAY_KEY_ID).
# When set, the pricing page opens the inline Razorpay checkout modal.
VITE_RAZORPAY_KEY_ID=rzp_test_T91l2EdavMNwEZ
